<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal - Ahora sin ActionBar -->
    <style name="Theme.NetAnalyzer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Colores de fondo -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Colores de superficie -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Colores de error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Colores de texto -->
        <item name="android:textColorPrimary">@color/on_primary</item>
        <item name="android:textColorSecondary">@color/on_secondary</item>

        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="colorControlActivated">@color/primary</item>
    </style>

    <style name="mySwitchStyle" parent="@style/Widget.AppCompat.CompoundButton.Switch" />
    <style name="mySwitchTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="switchStyle">@style/mySwitchStyle</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>