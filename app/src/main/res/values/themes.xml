<resources>
    <!-- Base sin ActionBar con valores por defecto (usando colores Light como base) -->
    <style name="Theme.NetAnalyzer.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Valores por defecto (tema Light) -->
        <item name="colorBackground">@color/light_background</item>
        <!-- ... resto de atributos ... -->

        <!-- Android framework attributes -->
        <item name="android:windowBackground">?attr/colorBackground</item>
        <!-- <item name="colorControlNormal">?attr/colorOnSurface</item>   --> <!-- COMENTA ESTA -->
        <!-- <item name="colorControlActivated">?attr/colorPrimary</item> --> <!-- COMENTA ESTA -->
        <item name="android:textColorPrimary">?attr/colorOnBackground</item>
        <item name="android:textColorSecondary">?attr/colorOnSurface</item>
    </style>

    <!-- Tema LIGHT: solo sobrescribe si hay diferencias (opcional, ya tiene los mismos valores) -->
    <style name="Theme.NetAnalyzer.Light" parent="Theme.NetAnalyzer.Base">
        <!-- Ya tiene los valores por defecto, puedes dejarlo vacío -->
    </style>

    <!-- Tema DARK -->
    <style name="Theme.NetAnalyzer.Dark" parent="Theme.NetAnalyzer.Base">
        <item name="colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnBackground">@color/dark_on_background</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_primary_variant</item>
        <item name="colorOnPrimary">@color/dark_on_primary</item>
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorOnSecondary">@color/dark_on_secondary</item>
        <item name="colorError">@color/dark_error</item>
        <item name="colorOnError">@color/dark_on_error</item>
        <item name="colorTerminal">@color/dark_terminal</item>
        <item name="colorOnTerminal">@color/dark_on_terminal</item>
        <item name="colorButton">@color/dark_button</item>
        <item name="colorWarning">@color/dark_warning</item>
        <item name="colorBackground10">@color/dark_background_10</item>
        <item name="colorPrimary70">@color/dark_primary_70</item>
        <item name="colorOnPrimary70">@color/dark_on_primary_70</item>
        <item name="colorTransparent">@color/dark_transparent</item>
    </style>

    <!-- Tema OCEAN -->
    <style name="Theme.NetAnalyzer.Ocean" parent="Theme.NetAnalyzer.Base">
        <item name="colorBackground">#FF0A1929</item>
        <item name="colorSurface">#FF112B3C</item>
        <item name="colorOnBackground">#FFE6F7FF</item>
        <item name="colorOnSurface">#B3E6F7FF</item>
        <item name="colorPrimary">#FF4F9DA6</item>
        <item name="colorPrimaryVariant">#FF1F6E8A</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">#FFA1E3F9</item>
        <item name="colorOnSecondary">#FF001F2B</item>
        <item name="colorError">#FFFF8A8A</item>
        <item name="colorOnError">#FF2B0000</item>
        <item name="colorTerminal">#FF02131F</item>
        <item name="colorOnTerminal">#FFA3D9F0</item>
        <item name="colorButton">#FF1F4E6E</item>
        <item name="colorWarning">#FFFFCB80</item>
        <item name="colorBackground10">#1AE6F7FF</item>
        <item name="colorPrimary70">#B34F9DA6</item>
        <item name="colorOnPrimary70">#B3FFFFFF</item>
        <item name="colorTransparent">#00000000</item>
    </style>

    <!-- Estilos auxiliares (sin cambios) -->
    <style name="mySwitchStyle" parent="Widget.Material3.CompoundButton.Switch" />

    <style name="AppBottomSheetDialogTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="RoundedDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Dialog.Rounded</item>
    </style>

    <style name="ShapeAppearanceOverlay.Dialog.Rounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Dialog" parent="ShapeAppearanceOverlay.Dialog.Rounded" />
</resources>