<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM STATUS"
            android:textSize="12sp"
            android:textColor="@color/primary"/>

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Network Hub"
            android:textSize="26sp"
            android:textColor="@color/on_background"
            android:textStyle="bold"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:id="@+id/layout_network_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:columnCount="2"
            android:rowCount="3">

            <LinearLayout
                android:id="@+id/info1"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0.5dp"
                android:layout_marginBottom="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_ip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL IP"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X.X.X.X"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info2"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0.5dp"
                android:layout_marginBottom="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_gateway_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GATEWAY"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_gateway"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X.X.X.X"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info3"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:layout_marginEnd="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_net_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NETWORK"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X.X.X.X/X"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info4"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:layout_marginStart="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_connection_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECTION"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_connection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/more"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_columnSpan="2"
                android:layout_gravity="fill_horizontal"
                android:layout_marginTop="1dp"
                android:background="@color/surface"
                android:focusable="true"
                android:padding="12dp"
                android:clickable="true"
                android:gravity="center"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_expand_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MORE"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>

                <ImageView
                    android:id="@+id/iv_expand_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Expandir información"
                    android:src="@drawable/ic_arrow_forward"
                    android:layout_gravity="center"
                    app:tint="@color/on_surface"/>
            </LinearLayout>

        </GridLayout>

    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/ring3"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/btn_scan"
        app:layout_constraintBottom_toBottomOf="@id/btn_scan"
        app:layout_constraintStart_toStartOf="@id/btn_scan"
        app:layout_constraintEnd_toEndOf="@id/btn_scan" />

    <View
        android:id="@+id/ring2"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/btn_scan"
        app:layout_constraintBottom_toBottomOf="@id/btn_scan"
        app:layout_constraintStart_toStartOf="@id/btn_scan"
        app:layout_constraintEnd_toEndOf="@id/btn_scan" />

    <View
        android:id="@+id/ring1"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/btn_scan"
        app:layout_constraintBottom_toBottomOf="@id/btn_scan"
        app:layout_constraintStart_toStartOf="@id/btn_scan"
        app:layout_constraintEnd_toEndOf="@id/btn_scan" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_button_gradient"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.15"
        android:text="SCAN"
        android:textColor="@color/on_primary_70"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="70dp"
        app:layout_constraintBottom_toTopOf="@id/tv_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_info"
        app:layout_constraintVertical_bias="0.4" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:text="READY"
        android:textColor="@color/primary"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/card_history"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_scan" />

    <LinearLayout
        android:id="@+id/advanced_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/round_button_selector_36"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/round_ripple_24"
        app:layout_constraintBottom_toTopOf="@id/card_history"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_status">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_advanced"
            android:layout_marginEnd="6dp"
            app:tint="@color/on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ADVANCED SETTINGS"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_history"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_status">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_document"
                    android:layout_marginEnd="6dp"
                    app:tint="@color/on_surface" />

                <TextView
                    android:id="@+id/tv_history_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LAST SCAN SUMMARY"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_history_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12h ago"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_devices_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14"
                        android:textColor="@color/on_background"
                        android:textStyle="bold"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEVICES FOUND"
                        android:textColor="@color/on_surface"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/background" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_time_elapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26 s"
                        android:textColor="@color/on_background"
                        android:textStyle="bold"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIME ELAPSED"
                        android:textColor="@color/on_surface"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>