<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM STATUS"
            android:textSize="12sp"
            android:textColor="@color/primary"/>

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Network Hub"
            android:textSize="26sp"
            android:textColor="@color/on_background"
            android:textStyle="bold"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:id="@+id/layout_network_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:columnCount="2"
            android:rowCount="2">

            <LinearLayout
                android:id="@+id/info1"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0.5dp"
                android:layout_marginBottom="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_ip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL IP"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X.X.X.X"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info2"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0.5dp"
                android:layout_marginBottom="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_gateway_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GATEWAY"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_gateway"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X.X.X.X"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info3"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:layout_marginEnd="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_net_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NETWORK"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X.X.X.X/X"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info4"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:layout_marginStart="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_connection_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECTION"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_connection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

        </GridLayout>

    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/ring3"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/btn_scan"
        app:layout_constraintBottom_toBottomOf="@id/btn_scan"
        app:layout_constraintStart_toStartOf="@id/btn_scan"
        app:layout_constraintEnd_toEndOf="@id/btn_scan" />

    <View
        android:id="@+id/ring2"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/btn_scan"
        app:layout_constraintBottom_toBottomOf="@id/btn_scan"
        app:layout_constraintStart_toStartOf="@id/btn_scan"
        app:layout_constraintEnd_toEndOf="@id/btn_scan" />

    <View
        android:id="@+id/ring1"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/btn_scan"
        app:layout_constraintBottom_toBottomOf="@id/btn_scan"
        app:layout_constraintStart_toStartOf="@id/btn_scan"
        app:layout_constraintEnd_toEndOf="@id/btn_scan" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:text="SCAN"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/on_primary_70"
        android:letterSpacing="0.15"
        app:backgroundTint="@null"
        android:background="@drawable/bg_button_gradient"
        app:cornerRadius="70dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintTop_toBottomOf="@id/card_info"
        app:layout_constraintBottom_toTopOf="@id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="READY"
        android:textSize="14sp"
        android:textColor="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>