<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:layout_margin="20dp">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:id="@+id/tv_subtitle"
            android:text="SYSTEM STATUS"
            android:textSize="12sp"
            android:textColor="@color/primary"/>

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Network Hub"
            android:textSize="26sp"
            android:textColor="@color/on_background"
            android:textStyle="bold"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|top"
        android:layout_marginTop="100dp"
        android:layout_marginHorizontal="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true"
        app:strokeWidth="0dp">

        <GridLayout
            android:id="@+id/layout_network_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:columnCount="2"
            android:rowCount="2">

            <LinearLayout
                android:id="@+id/info1"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0.5dp"
                android:layout_marginBottom="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_ip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL IP"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.1.34"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info2"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0.5dp"
                android:layout_marginBottom="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_gateway_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GATEWAY"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_gateway"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.1.1"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info3"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:layout_marginEnd="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_range_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RANGE"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.1.34/24"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info4"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:layout_marginStart="0.5dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_connection_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECTION"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"/>
                <TextView
                    android:id="@+id/tv_connection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WIFI 6"
                    android:textSize="16sp"
                    android:textColor="@color/on_background"/>
            </LinearLayout>

        </GridLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Ripple rings (animadas desde código) -->
    <View
        android:id="@+id/ring3"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        android:scaleX="1"
        android:scaleY="1" />

    <View
        android:id="@+id/ring2"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_gravity="center"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        android:scaleX="1"
        android:scaleY="1" />

    <View
        android:id="@+id/ring1"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:background="@drawable/scan_ring"
        android:alpha="0"
        android:scaleX="1"
        android:scaleY="1" />

    <!-- Botón SCAN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:text="SCAN"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/on_primary_70"
        android:letterSpacing="0.15"
        app:backgroundTint="@null"
        android:background="@drawable/bg_button_gradient"
        app:cornerRadius="70dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Estado label -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_marginBottom="120dp"
        android:text=""
        android:textSize="14sp"
        android:textColor="@color/primary"
        android:alpha="0" />

</FrameLayout>
