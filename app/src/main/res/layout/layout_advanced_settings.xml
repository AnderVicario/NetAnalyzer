<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/advanced_configuration"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_import"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/round_button_selector_36_adv"
            android:padding="2dp"
            android:src="@drawable/ic_import"
            app:tint="?attr/colorOnSurface" />

        <View
            android:layout_width="4dp"
            android:layout_height="0dp" />

        <ImageButton
            android:id="@+id/btn_export"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/round_button_selector_36_adv"
            android:padding="2dp"
            android:src="@drawable/ic_export"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"
        android:text="@string/scan_methods_long_press"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />

    <!-- Matriz 3 columnas -->
    <GridLayout
        android:id="@+id/grid_methods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:columnOrderPreserved="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_method_auto"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:checkable="true"
            android:text="@string/auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_method_arp"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:checkable="true"
            android:text="@string/arp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_method_tcp"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:checkable="true"
            android:text="@string/tcp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_method_icmp"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:checkable="true"
            android:text="@string/icmp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_method_mdns"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:checkable="true"
            android:text="@string/mdns" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_method_ssdp"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:checkable="true"
            android:text="@string/ssdp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_method_netbios"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:checkable="true"
            android:text="@string/netbios" />

    </GridLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.7"
        android:text="@string/ports_to_scan"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_group_ports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btn_ports_100"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ports_100" />

        <Button
            android:id="@+id/btn_ports_500"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ports_500" />

        <Button
            android:id="@+id/btn_ports_1000"
            style="@style/Widget.App.MethodButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ports_1000" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <Button
        android:id="@+id/btn_save_config"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/apply_settings"
        app:cornerRadius="12dp" />

</LinearLayout>